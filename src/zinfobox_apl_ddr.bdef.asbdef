managed implementation in class zbp_infobox_apl_ddr unique;
strict ( 2 );
with draft;

define behavior for ZINFOBOX_APL_DDR //alias <alias_name>
persistent table zmy_applications
draft table zmy_applicat_dr
lock master total etag Updatedat
authorization master ( global, instance )
//etag master <field_name>
{
  create( authorization : global );
  update;
  delete;
  determination setInitialValues on modify { create; }

  draft action Edit;
  draft action Activate optimized;
  draft action Discard;
  draft action Resume;
  draft determine action Prepare;

  field ( numbering : managed, readonly ) ID_apl;
  field ( readonly ) Applnum, Createdat, Updatedat;

  mapping for zmy_applications corresponding;
}