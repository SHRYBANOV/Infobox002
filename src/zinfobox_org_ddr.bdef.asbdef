managed implementation in class zbp_infobox_org_ddr unique;
strict ( 2 );
with draft;

define behavior for ZINFOBOX_ORG_DDR //alias <alias_name>
persistent table zorganizations
draft table zorganizat_dr
lock master total etag updatedat
authorization master ( global, instance )
//etag master <field_name>
{
  create( authorization : global );
  update;
  delete;

  draft action Edit;
  draft action Activate optimized;
  draft action Discard;
  draft action Resume;
  draft determine action Prepare;

  field ( numbering : managed, readonly ) id_org;
  field ( readonly ) createdat, updatedat;

  mapping for zorganizations corresponding;
}