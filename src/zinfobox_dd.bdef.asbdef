managed implementation in class zbp_infobox_dd unique;
strict ( 2 );
with draft;

define behavior for ZINFOBOX_DD //alias <alias_name>
persistent table zpersonal
draft table zpersonal_dr
lock master total etag updatedat
authorization master ( global, instance )
//etag master <field_name>
{
  create; //{ default function GetDefaultsForCreate; }
  update ( precheck );
  delete;
  field ( numbering : managed, readonly ) ID;
  field ( mandatory ) Firstname, Lastname;
  field ( readonly ) createdat, updatedat;
  field ( readonly ) Descr, Descr2, Descr3, Descr4, Descr5, Tabnum_txt;
  //  field ( readonly ) Tabnum;
  //  determination setInitialTabnum on modify { create; }
  determination setInitialValues on modify { create; }

  draft action Edit;
  draft action Activate optimized;
  draft action Discard;
  draft action Resume;
  draft determine action Prepare;

  static action DEPData result [1] $self;
//  static action ORGData result [1] $self;
//  static action POSData result [1] $self;
//  static action UNITData result [1] $self;

  mapping for zpersonal corresponding
    {
      Attachment = attachement;
    }

}